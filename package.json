{
  "name": "firefox-profiles",
  "version": "4.0.0",
  "private": true,
  "description": "This GNOME extension streamlines launching Firefox profiles from the indicator menu.",
  "homepage": "https://github.com/baxyz/firefox-profiles#readme",
  "bugs": {
    "url": "https://github.com/baxyz/firefox-profiles/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "baxyz <berenger@arnaud.work>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baxyz/firefox-profiles.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "shexli": "pnpm build && cp metadata.json dist/ && (cd dist && zip ../firefox-profiles.zip -9r .) && (shexli firefox-profiles.zip || (echo 'shexli not found — install with: pipx install shexli' && exit 1))"
  },
  "devDependencies": {
    "@girs/gjs": "4.0.0-rc.15",
    "@girs/gnome-shell": "^50.0.0",
    "@girs/gnome-shell-46": "npm:@girs/gnome-shell@46",
    "@girs/gnome-shell-47": "npm:@girs/gnome-shell@47",
    "@girs/gnome-shell-48": "npm:@girs/gnome-shell@48",
    "@girs/gnome-shell-49": "npm:@girs/gnome-shell@49",
    "@girs/gnome-shell-50": "npm:@girs/gnome-shell@50",
    "@types/node": "^25.6.2",
    "@vitest/ui": "^4.1.5",
    "esbuild": "^0.28.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.20.0"
}